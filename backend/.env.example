# FINN Backend — Environment Variables
# Copy this to .env and fill in your values

# Anthropic API key (required for Phase 2+ classification and Phase 3 research)
ANTHROPIC_API_KEY=

# Server settings
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database & Persistent Storage (Render Persistent Disk: mount at /var/data and set DATA_DIR=/var/data)
# DATA_DIR=/var/data
DATABASE_URL=sqlite:///./finn.db

# CORS: comma-separated list of allowed frontend origins (e.g. https://finn-app.vercel.app)
# Vercel *.vercel.app domains are supported automatically.
CORS_ORIGINS=

# Scheduling intervals (seconds)
NSE_FETCH_INTERVAL=300     # every 5 minutes during market hours
PRICE_REFRESH_INTERVAL=86400  # once per day (EOD)

# yfinance settings
YF_HISTORY_DAYS=30         # days of price history to keep
YF_AVG_VOL_WINDOW=20       # days for average volume baseline

# Request timeouts
HTTP_TIMEOUT=15
